                  $\hat{b} = \frac{250}{50} = \mathbf{5}$, 
                  $\hat{a} = \frac{50}{50} = \mathbf{1}$
                </div>
                <div>(3) 推定した回帰式 $\hat{p}_t = 1t + 5$ に基づいて、$t = 6$ 年における人口を予測せよ。</div>
                <div class="pl-2">
                  $\hat{p}_6 = 1 \times 6 + 5 =$ <strong class="ans-red text-sm"> 11 </strong>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Footer Right -->
        <div class="border-t border-gray-800 pt-1 flex justify-between items-center text-[10px]">
          <span class="font-bold">九州共立大学 経済学部</span>
          <span>学科( &nbsp;&nbsp;&nbsp;&nbsp; ) ・学年( &nbsp;&nbsp;&nbsp;&nbsp; )クラス</span>
          <span>学籍番号：_________________</span>
          <span>氏名：_____________________</span>
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom Toolbar (Fixed position for A4 Landscape Mode) -->
  <footer class="no-print bg-slate-900 text-white p-3 shadow-lg border-t border-slate-700 sticky bottom-0 z-50">
    <div class="max-w-6xl mx-auto flex flex-wrap justify-between items-center gap-3">
      <div class="flex items-center space-x-2">
        <i class="fa-solid me-1 fa-file-invoice text-blue-400 text-lg"></i>
        <span class="font-bold text-sm">人口学 テスト対策［2in1］キャンバス編集</span>
      </div>

      <!-- Button Group -->
      <div class="flex flex-wrap items-center gap-2">
        <!-- Answer Toggle Button -->
        <button id="toggleAnsBtn" onclick="toggleAnswers()" class="px-3 py-1.5 rounded text-xs font-semibold bg-amber-600 hover:bg-amber-500 transition flex items-center gap-1.5">
          <i class="fa-solid fa-eye-slash"></i>
          <span>解答表示 ON/OFF</span>
        </button>

        <!-- Edit/Update Button -->
        <button id="editBtn" onclick="toggleEditMode()" class="px-3 py-1.5 rounded text-xs font-semibold bg-blue-600 hover:bg-blue-500 transition flex items-center gap-1.5">
          <i class="fa-solid fa-pen-to-square"></i>
          <span id="editText">直接編集モード: OFF</span>
        </button>

        <!-- Print Button -->
        <button onclick="window.print()" class="px-3 py-1.5 rounded text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 transition flex items-center gap-1.5">
          <i class="fa-solid fa-print"></i>
          <span>ブラウザ印刷</span>
        </button>

        <!-- PDF Export Button -->
        <button onclick="downloadPDF()" class="px-3 py-1.5 rounded text-xs font-semibold bg-rose-600 hover:bg-rose-500 transition flex items-center gap-1.5">
          <i class="fa-solid fa-file-pdf"></i>
          <span>PDFで保存</span>
        </button>
      </div>
    </div>
  </footer>

  <!-- Script for Actions -->
  <script>
    let isEditing = false;
    let answersVisible = true;

    // Toggle Editable Mode
    function toggleEditMode() {
      isEditing = !isEditing;
      const container = document.getElementById('print-area');
      const btnText = document.getElementById('editText');
      
      if (isEditing) {
        container.contentEditable = "true";
        container.classList.add('editable-active');
        btnText.innerText = "直接編集モード: ON";
      } else {
        container.contentEditable = "false";
        container.classList.remove('editable-active');
        btnText.innerText = "直接編集モード: OFF";
      }
    }

    // Toggle 赤ペン解答表示
    function toggleAnswers() {
      answersVisible = !answersVisible;
      const redAnswers = document.querySelectorAll('.ans-red');
      redAnswers.forEach(el => {
        if (answersVisible) {
          el.style.visibility = 'visible';
        } else {
          el.style.visibility = 'hidden';
        }
      });
    }

    // PDF Download Function using html2pdf
    function downloadPDF() {
      const element = document.getElementById('print-area');
      
      // PDF化時に確実に1ページに収めるための一時的な高さ調整 (297mm x 208mm)
      const originalHeight = element.style.height;
      element.style.height = '208mm';

      const opt = {
        margin:       0,
        filename:     '人口学_第14回_テスト対策_2in1.pdf',
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2, useCORS: true, logging: false },
        jsPDF:        { unit: 'mm', format: 'a4', orientation: 'landscape' }
      };

      html2pdf().set(opt).from(element).save().then(() => {
        element.style.height = originalHeight || '210mm';
      }).catch(err => {
        console.error('PDF Generation Error:', err);
        element.style.height = originalHeight || '210mm';
      });
    }

    // Auto-scale preview window for mobile/smaller screens
    function adjustScale() {
      const wrapper = document.getElementById('preview-container');
      const target = document.getElementById('print-area');
      const windowWidth = wrapper.clientWidth - 16;
      const targetWidth = 1122; // 297mm in standard px (~96dpi)

      if (windowWidth < targetWidth) {
        const scale = windowWidth / targetWidth;
        target.style.transform = `scale(${scale})`;
        target.style.transformOrigin = 'center top';
      } else {
        target.style.transform = 'scale(1)';
      }
    }

    window.addEventListener('resize', adjustScale);
    window.addEventListener('DOMContentLoaded', adjustScale);
  </script>
</body>
</html>

